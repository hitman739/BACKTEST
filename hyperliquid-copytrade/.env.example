# Hyperliquid CopyTrade Configuration

# Your Hyperliquid API credentials
API_KEY=your_api_key_here
API_SECRET=0x_your_private_key_here

# Target wallet to copy
TARGET_WALLET=0x_target_wallet_address

# Network (true = testnet, false = mainnet)
TESTNET=true

# Backend API settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
